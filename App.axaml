<Application
	x:Class="FileViewerApp.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:conv="clr-namespace:FileViewerApp.Converters"
	RequestedThemeVariant="Light">
	<Application.Resources>
		<!--  Converters  -->
		<conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
		<conv:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
		<conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
		<conv:SelectedParamIndexToBrushConverter x:Key="SelectedParamIndexToBrushConverter" />
		<conv:ParamSelectedBrushConverter x:Key="ParamSelectedBrushConverter" />
		<conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
		<conv:BooleanToThicknessConverter x:Key="BooleanToThicknessConverter" />
		<conv:CutPendingToOpacityConverter x:Key="CutPendingToOpacityConverter" />
		<conv:DiffKindToBrushConverter x:Key="DiffKindToBrushConverter" />
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="avares://FileViewerApp/Styles/ThemeStyles.axaml" />
	</Application.Styles>
</Application>
