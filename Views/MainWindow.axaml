<Window
    x:Class="FileViewerApp.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FileViewerApp.Models"
    xmlns:vm="using:FileViewerApp.ViewModels"
    Title="File Viewer App"
    Width="1200"
    Height="800"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!--  Toolbar  -->
        <Border
            Grid.Row="0"
            Background="#F5F5F5"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
            <StackPanel Margin="10,5" Orientation="Horizontal">
                <Button
                    Margin="5,0"
                    Padding="15,8"
                    Background="#2563EB"
                    Command="{Binding OpenFileCommand}"
                    Content="📁 Apri File"
                    Foreground="White" />
                <Button
                    Margin="5,0"
                    Padding="15,8"
                    Background="#DC2626"
                    Command="{Binding CloseFileCommand}"
                    Content="❌ Chiudi"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <!--  Main Content Area con TabControl  -->
        <TabControl
            Grid.Row="1"
            Background="White"
            TabStripPlacement="Top">

            <!--  Tab Editor  -->
            <TabItem Header="📝 Editor">
                <Border Background="White">
                    <TextBox
                        Margin="10"
                        Background="White"
                        BorderThickness="0"
                        FontFamily="Cascadia Code, Consolas, 'Courier New'"
                        FontSize="12"
                        Foreground="#1F2937"
                        IsReadOnly="True"
                        Text="{Binding EditorText}"
                        TextWrapping="Wrap" />
                </Border>
            </TabItem>

            <!--  Tab Hex View  -->
            <TabItem Header="🔢 Hex View">
                <Border Background="White">
                    <ScrollViewer>
                        <TextBox
                            Margin="10"
                            Background="White"
                            BorderThickness="0"
                            FontFamily="Cascadia Code, Consolas, 'Courier New'"
                            FontSize="12"
                            Foreground="#1F2937"
                            IsReadOnly="True"
                            Text="{Binding HexView}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!--  Tab Decoder  -->
            <TabItem Header="🔧 Decoder">
                <Border Background="White">
                    <ScrollViewer>
                        <TextBox
                            Margin="10"
                            Background="White"
                            BorderThickness="0"
                            FontFamily="Cascadia Code, Consolas, 'Courier New'"
                            FontSize="12"
                            Foreground="#1F2937"
                            IsReadOnly="True"
                            Text="{Binding DecodedData}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!--  Tab Istruzioni  -->
            <TabItem Header="📋 Istruzioni">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <!--  TreeView delle istruzioni  -->
                    <TreeView
                        Grid.Row="0"
                        Margin="10"
                        ItemsSource="{Binding InstructionTree}"
                        SelectedItem="{Binding SelectedNode}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="models:InstructionNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Text="{Binding DisplayText}" />
                                    <TextBlock
                                        Margin="5,0"
                                        Foreground="Gray"
                                        Text=" - " />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="DarkGray"
                                        Text="{Binding Details}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                        <TreeView.Styles>
                            <Style x:DataType="models:InstructionNode" Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>

                    <!--  Splitter  -->
                    <GridSplitter
                        Grid.Row="1"
                        Height="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="LightGray" />

                    <!--  Dettagli del nodo selezionato  -->
                    <Border
                        Grid.Row="2"
                        Margin="10,0,10,10"
                        Padding="10"
                        Background="LightGray">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,5"
                                FontWeight="Bold"
                                Text="Dettagli Istruzione Selezionata:" />
                            <TextBlock FontFamily="Consolas">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Nome: {0}">
                                        <Binding FallbackValue="(nessuna selezione)" Path="SelectedNode.Name" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Numero: {0}">
                                        <Binding FallbackValue="N/A" Path="SelectedNode.InstructionNumber" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Offset: 0x{0:X6}">
                                        <Binding FallbackValue="0" Path="SelectedNode.Offset" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="OpCode: {0}">
                                        <Binding FallbackValue="0" Path="SelectedNode.OpCode" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Parametri: {0}">
                                        <Binding FallbackValue="(nessun parametro)" Path="SelectedNode.Parameters" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!--  Tab Properties  -->
            <TabItem Header="📋 Proprietà">
                <Border Background="White">
                    <ScrollViewer>
                        <StackPanel Margin="20">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1F2937"
                                Text="Informazioni File" />

                            <Grid
                                Margin="0,10"
                                ColumnDefinitions="150,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Foreground="#6B7280"
                                    Text="Nome file:" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10,5,0,5"
                                    Foreground="#1F2937"
                                    Text="{Binding FileName}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Foreground="#6B7280"
                                    Text="Dimensione:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10,5,0,5"
                                    Foreground="#1F2937"
                                    Text="{Binding FileSize}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Foreground="#6B7280"
                                    Text="Linee:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="10,5,0,5"
                                    Foreground="#1F2937"
                                    Text="{Binding LineCount}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Foreground="#6B7280"
                                    Text="Caratteri:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="10,5,0,5"
                                    Foreground="#1F2937"
                                    Text="{Binding CharCount}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,5"
                                    Foreground="#6B7280"
                                    Text="Encoding:" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="10,5,0,5"
                                    Foreground="#1F2937"
                                    Text="{Binding FileEncoding}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
