<Window
    x:Class="FileViewerApp.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileViewerApp.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AvaloniaControls.Models"
    xmlns:vm="using:FileViewerApp.ViewModels"
    Title="FileViewer Pro - Visualizzatore e Convertitore File Programma"
    MinWidth="900"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:DataType="vm:MainWindowViewModel"
    WindowState="Maximized"
    mc:Ignorable="d">

    <!--  Root grid so overlay can span entire window  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <controls:ToolbarControl Grid.Row="0" DataContext="{Binding ToolbarViewModel}" />

        <!--  Main content area  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="260" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--  Tree column  -->
            <Grid
                Grid.Column="0"
                Margin="0,0,0,4"
                RowDefinitions="Auto,*">
                <StackPanel
                    Margin="6"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Classes="expand-btn"
                        Command="{Binding ExpandAllCommand}"
                        ToolTip.Tip="Espandi tutta la struttura">
                        <TextBlock FontSize="14" Text="▾" />
                    </Button>
                    <Button
                        Classes="expand-btn"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip.Tip="Collassa tutta la struttura">
                        <TextBlock FontSize="14" Text="▴" />
                    </Button>
                </StackPanel>
                <controls:InstructionTreeControl Grid.Row="1" DataContext="{Binding}" />
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Background="#E0E0E0"
                ResizeDirection="Columns" />
            <controls:ContentTabsControl Grid.Column="2" DataContext="{Binding ContentTabsViewModel}" />
            <GridSplitter
                Grid.Column="3"
                Background="#E0E0E0"
                ResizeDirection="Columns" />
            <controls:HistoryPanelControl Grid.Column="4" DataContext="{Binding}" />
        </Grid>

        <!--  Status bar  -->
        <controls:StatusBarControl Grid.Row="2" DataContext="{Binding}" />

        <!--  Full window overlay spinner  -->
        <Border
            Grid.RowSpan="3"
            Background="#80000000"
            IsVisible="{Binding IsProcessing}"
            ZIndex="1000">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <controls:SpinnerControl />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding OperationDescription}" />
                    <TextBlock
                        FontStyle="Italic"
                        Foreground="#E0E0E0"
                        Text="Attendere..." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
