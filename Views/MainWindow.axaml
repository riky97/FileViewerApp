<Window
    x:Class="FileViewerApp.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileViewerApp.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:AvaloniaControls.Models"
    xmlns:vm="using:FileViewerApp.ViewModels"
    Title="FileViewer Pro - Visualizzatore e Convertitore File Programma"
    MinWidth="900"
    MinHeight="600"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">

    <DockPanel>

        <!--  📁 TOOLBAR SUPERIORE  -->
        <controls:ToolbarControl DataContext="{Binding ToolbarViewModel}" DockPanel.Dock="Top" />

        <!--  📊 STATUS BAR INFERIORE  -->
        <controls:StatusBarControl DataContext="{Binding}" DockPanel.Dock="Bottom" />

        <!--  🏠 MAIN CONTENT AREA  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!--  🌳 LEFT PANEL: TreeView  -->
			<Grid Grid.Column="0" RowDefinitions="Auto,*">
				<!-- Barra pulsanti -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
					<Button Classes="expand-btn" Command="{Binding ExpandAllCommand}" ToolTip.Tip="Espandi tutta la struttura">
						<TextBlock FontSize="14" Text="▾" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Button>
					<Button Classes="expand-btn" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collassa tutta la struttura">
						<TextBlock FontSize="14" Text="▴" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Button>
				</StackPanel>

				<!-- TreeView -->
				<controls:InstructionTreeControl Grid.Row="1" DataContext="{Binding}" />
			</Grid>


			<!--  SPLITTER  -->
            <GridSplitter
                Grid.Column="1"
                Background="#E0E0E0"
                ResizeDirection="Columns" />

            <!--  📝 RIGHT PANEL: Content Tabs  -->
            <controls:ContentTabsControl Grid.Column="2" DataContext="{Binding ContentTabsViewModel}" />

        </Grid>

    </DockPanel>

</Window>
