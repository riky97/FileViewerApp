<UserControl
    x:Class="FileViewerApp.Views.Controls.SpinnerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="72"
    Height="72">
    <Grid>
        <Ellipse
            x:Name="Ring"
            Width="72"
            Height="72"
            Stroke="#2196F3"
            StrokeDashArray="20,16"
            StrokeThickness="6">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="0" CenterX="36" CenterY="36" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
