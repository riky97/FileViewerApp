<UserControl
  x:Class="FileViewerApp.Views.Controls.InstructionTreeControl"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:FileViewerApp.ViewModels"
  d:DesignHeight="450"
  d:DesignWidth="300"
  x:DataType="vm:MainWindowViewModel"
  mc:Ignorable="d">

	<Border
	  Background="#FFFFFF"
	  BorderBrush="#E0E0E0"
	  BorderThickness="0,0,1,0">

		<DockPanel>
			<!--  TreeView Header  -->
			<Border
			  Padding="12,8"
			  Background="#F1F3F4"
			  DockPanel.Dock="Top">
				<TextBlock
				  FontSize="14"
				  FontWeight="Medium"
				  Text="🌳 Struttura Istruzioni" />
			</Border>

			<!--  TreeView Content  -->
			<TreeView
				Name="InstructionTreeView"
				Padding="8"
				ItemsSource="{Binding InstructionTree}"
				SelectedItem="{Binding SelectedNode}">

				<TreeView.Styles>
					<Style Selector="TreeViewItem">
						<Setter Property="IsExpanded"
								Value="{ReflectionBinding $self.DataContext.IsExpanded, Mode=TwoWay}" />
					</Style>
				</TreeView.Styles>

				<TreeView.ItemTemplate>
					<TreeDataTemplate ItemsSource="{Binding Children}">
						<StackPanel Orientation="Horizontal">
							<TextBlock  FontWeight="Medium" Text="{Binding DisplayWithParams}" />
						</StackPanel>
					</TreeDataTemplate>
				</TreeView.ItemTemplate>

			</TreeView>
		</DockPanel>
	</Border>
</UserControl>
