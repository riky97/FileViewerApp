<UserControl
  x:Class="FileViewerApp.Views.Controls.ToolbarControl"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:FileViewerApp.ViewModels"
  d:DesignHeight="60"
  d:DesignWidth="800"
  x:DataType="vm:MainWindowViewModel"
  mc:Ignorable="d">

  <Border
    Padding="8"
    Background="#FFFFFF"
    BorderBrush="#E0E0E0"
    BorderThickness="0,0,0,1">

    <StackPanel Orientation="Horizontal">

      <!--  File Operations  -->
      <Button
        Name="OpenButton"
        Command="{Binding OpenFileCommand}"
        IsEnabled="{Binding !IsProcessing}"
        ToolTip.Tip="Apri file (Ctrl+O)">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,8,0"
            FontSize="16"
            Text="📁" />
          <TextBlock Text="Apri File" />
        </StackPanel>
      </Button>

      <Button
        Name="SaveButton"
        Command="{Binding SaveFileCommand}"
        IsEnabled="{Binding !IsProcessing}"
        ToolTip.Tip="Salva file (Ctrl+S)">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,8,0"
            FontSize="16"
            Text="💾" />
          <TextBlock Text="Salva" />
        </StackPanel>
      </Button>

      <Separator
        Width="1"
        Height="24"
        Margin="8,4"
        Background="#E0E0E0" />

      <!--  Convert Operations  -->
      <Button
        Name="ConvertButton"
        Background="#4CAF50"
        Command="{Binding ConvertFileCommand}"
        IsEnabled="{Binding !IsProcessing}"
        ToolTip.Tip="Converti formato file">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,8,0"
            FontSize="16"
            Text="🔄" />
          <TextBlock Text="Converti" />
        </StackPanel>
      </Button>

      <Button
        Name="RefreshButton"
        Background="#FF9800"
        Command="{Binding RefreshCommand}"
        IsEnabled="{Binding !IsProcessing}"
        ToolTip.Tip="Aggiorna file (F5)">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,8,0"
            FontSize="16"
            Text="🔄" />
          <TextBlock Text="Aggiorna" />
        </StackPanel>
      </Button>

      <Separator
        Width="1"
        Height="24"
        Margin="8,4"
        Background="#E0E0E0" />

      <!--  Close  -->
      <Button
        Name="CloseButton"
        Background="#F44336"
        Command="{Binding CloseFileCommand}"
        ToolTip.Tip="Chiudi file">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,8,0"
            FontSize="16"
            Text="❌" />
          <TextBlock Text="Chiudi" />
        </StackPanel>
      </Button>

      <!--  Progress Indicator  -->
      <StackPanel
        Margin="20,0,0,0"
        IsVisible="{Binding IsProcessing}"
        Orientation="Horizontal">
        <TextBlock
          Margin="0,0,8,0"
          FontSize="16"
          Text="⏳" />
        <TextBlock
          FontStyle="Italic"
          Foreground="#666666"
          Text="Elaborazione in corso..." />
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
