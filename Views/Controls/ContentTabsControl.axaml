<UserControl
  x:Class="FileViewerApp.Views.Controls.ContentTabsControl"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="clr-namespace:FileViewerApp.Models"
  xmlns:vm="clr-namespace:FileViewerApp.ViewModels.Controls"
  x:Name="Root"
  x:DataType="vm:ContentTabsControlViewModel"
  mc:Ignorable="d">

	<TabControl>
		<!--  TAB HEX  -->
		<!--<TabItem Header="🔢 Hex">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock
				  Grid.Row="0"
				  Margin="0,0,0,10"
				  FontSize="14"
				  FontWeight="Bold"
				  Text="Vista Esadecimale" />
				<ScrollViewer Grid.Row="1">
					<TextBox
					  FontFamily="Consolas"
					  FontSize="11"
					  IsReadOnly="True"
					  Text="{Binding HexView}"
					  TextWrapping="NoWrap" />
				</ScrollViewer>
			</Grid>
		</TabItem>-->

		<!--  TAB LISTA ISTRUZIONI  -->
		<TabItem Header="📋 Istruzioni">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock
				  Grid.Row="0"
				  Margin="0,0,0,10"
				  FontSize="14"
				  FontWeight="Bold"
				  Text="Lista Istruzioni" />
				<ScrollViewer Grid.Row="1">
					<TextBox
					  FontFamily="Consolas"
					  FontSize="12"
					  IsReadOnly="True"
					  Text="{Binding InstructionView}"
					  TextWrapping="NoWrap" />
				</ScrollViewer>
			</Grid>
		</TabItem>

		<!--  TAB EDITOR ISTRUZIONI  -->
		<TabItem Header="✏️ Editor Istruzioni" IsEnabled="{Binding IsEditMode}">
			<DockPanel Margin="10">
				<StackPanel
				  Margin="0,0,0,10"
				  DockPanel.Dock="Top"
				  Orientation="Horizontal"
				  Spacing="8">
					<Button Command="{Binding AddInstructionCommand}" Content="➕ Aggiungi" />
					<Button
					  Command="{Binding RemoveInstructionCommand}"
					  Content="🗑️ Rimuovi"
					  IsEnabled="{Binding CanRemoveInstruction}" />
					<Button
					  Command="{Binding MoveUpCommand}"
					  Content="⬆️ Su"
					  IsEnabled="{Binding CanMoveUp}" />
					<Button
					  Command="{Binding MoveDownCommand}"
					  Content="⬇️ Giù"
					  IsEnabled="{Binding CanMoveDown}" />
					<Separator />
					<Button
					  Command="{Binding SaveChangesCommand}"
					  Content="💾 Salva"
					  IsEnabled="{Binding HasUnsavedChanges}" />
					<Button
					  Command="{Binding DiscardChangesCommand}"
					  Content="↶ Scarta"
					  IsEnabled="{Binding HasUnsavedChanges}" />
				</StackPanel>

				<ListBox ItemsSource="{Binding EditableInstructions}" SelectedItem="{Binding SelectedInstruction}">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="models:EditableInstruction">
							<Border
							  Margin="2"
							  Padding="6"
							  BorderBrush="#DDD"
							  BorderThickness="1"
							  CornerRadius="3">
								<Grid MinHeight="30" ColumnDefinitions="60,220,*,Auto">
									<TextBlock
									  Grid.Column="0"
									  VerticalAlignment="Center"
									  FontWeight="Bold"
									  Text="{Binding Number, StringFormat='{}{0:D3}'}" />
									<ComboBox
									  Grid.Column="1"
									  Margin="8,0"
									  IsEnabled="{Binding DataContext.IsEditMode, ElementName=Root}"
									  ItemsSource="{Binding DataContext.AvailableInstructions, ElementName=Root}"
									  SelectedItem="{Binding Name, Mode=TwoWay}"
									  SelectionChanged="OnInstructionSelectionChanged"
									  Tag="{Binding}">
										<!--  Force item display as text  -->
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock FontFamily="Consolas" Text="{Binding}" />
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<ItemsControl Grid.Column="2" ItemsSource="{Binding VisibleParameterEntries}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal" Spacing="4" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:InstructionParameter">
												<StackPanel Spacing="2">
													<TextBox Width="140"
															 Watermark="Filtro"
															 Text="{Binding FilterText, Mode=TwoWay}"
															 IsVisible="{Binding HasOptions}" />
													<ComboBox Width="160"
															  ItemsSource="{Binding FilteredOptions}"
															  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
															  IsVisible="{Binding HasOptions}">
														<ComboBox.ItemTemplate>
															<DataTemplate x:DataType="models:ResourceOption">
																<TextBlock Text="{Binding Display}"
																		   ToolTip.Tip="{Binding Item.Description}" />
															</DataTemplate>
														</ComboBox.ItemTemplate>
													</ComboBox>
													<TextBox Width="70"
															 TextAlignment="Center"
															 Watermark="{Binding Index, StringFormat='P{0}'}"
															 Text="{Binding Value, Mode=TwoWay}"
															 IsVisible="{Binding HasOptions, Converter={StaticResource InverseBooleanConverter}}" />
													<Border BorderThickness="1"
															CornerRadius="3"
															Padding="2"
															BorderBrush="{Binding IsValueValid, Converter={StaticResource BooleanToBrushConverter}}"
															IsVisible="{Binding HasOptions}">
														<TextBlock FontSize="10"
																   Text="{Binding Value, StringFormat='Valore: {0}'}" />
													</Border>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{Binding IsValid, Converter={StaticResource BooleanToBrushConverter}}" Text="{Binding ValidationSummary}" />
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</TabItem>
	</TabControl>
</UserControl>
